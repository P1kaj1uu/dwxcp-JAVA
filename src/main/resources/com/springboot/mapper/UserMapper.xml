<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    namespace：命名空间
    id：sql语句的唯一标识
    resultType：返回值类型
-->
<mapper namespace="com.springboot.dwxcp.mapper.UserMapper">
    <!-- 不查密码字段，避免泄漏到前端 -->
    <resultMap id="BaseResultMap" type="com.springboot.dwxcp.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
    </resultMap>

    <!-- 仅 username 字段映射；调用方拿到 password 字段为 null -->
    <resultMap id="BaseResultMapWithPassword" type="com.springboot.dwxcp.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
    </resultMap>

    <select id="selectUserList" resultMap="BaseResultMap">
        SELECT id, username
        FROM user
        ORDER BY id DESC
    </select>

    <select id="selectMyUser" resultMap="BaseResultMap">
        SELECT id, username
        FROM user
        WHERE id = #{id}
    </select>

    <select id="selectInfoByName" resultMap="BaseResultMapWithPassword">
        SELECT id, username, password
        FROM user
        WHERE username = #{username}
    </select>

    <update id="editUserPasswordById" parameterType="com.springboot.dwxcp.entity.User">
        update user
        <set>
            <if test="password != null and password != ''">password=#{password}</if>
        </set>
        where username = #{username}
    </update>

    <delete id="deleteUserById">
        delete from user where id = #{id}
    </delete>

    <insert id="addUser" useGeneratedKeys="true" keyProperty="id">
        insert into user (username, password)
        values (#{username}, #{password})
    </insert>
</mapper>