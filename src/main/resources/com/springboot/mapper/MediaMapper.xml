<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.dwxcp.mapper.MediaMapper">

    <!-- 列表：不含 BLOB -->
    <resultMap id="BaseResultMap" type="com.springboot.dwxcp.entity.Media">
        <id column="id" property="id" />
        <result column="file_name" property="fileName" />
        <result column="file_type" property="fileType" />
        <result column="category" property="category" />
        <result column="file_url" property="fileUrl" />
    </resultMap>

    <!-- 单条：含 BLOB -->
    <resultMap id="WithContentResultMap" type="com.springboot.dwxcp.entity.Media">
        <id column="id" property="id" />
        <result column="file_name" property="fileName" />
        <result column="file_type" property="fileType" />
        <result column="category" property="category" />
        <result column="file_url" property="fileUrl" />
        <result column="file_content" property="fileContent" />
    </resultMap>

    <!-- 列表查询（不包含大字段 file_content） -->
    <select id="selectMediaListWithoutContent" resultMap="BaseResultMap">
        SELECT id, file_name, file_type, category, file_url
        FROM media
        WHERE category = #{category}
        ORDER BY id DESC
        LIMIT 200
    </select>

    <!-- 根据ID查询（包含 file_content，下载用） -->
    <select id="selectMediaById" resultMap="WithContentResultMap">
        SELECT id, file_name, file_type, category, file_url, file_content
        FROM media
        WHERE id = #{id}
    </select>

    <!-- 仅查 file_content（下载专用，避免拉全行） -->
    <select id="selectMediaContent" resultType="byte[]">
        SELECT file_content
        FROM media
        WHERE id = #{id}
    </select>

    <!-- 删除媒体文件 -->
    <delete id="deleteMediaById">
        DELETE FROM media WHERE id = #{id}
    </delete>

</mapper>