<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    namespace：命名空间
    id：sql语句的唯一标识
    resultType：返回值类型
-->
<mapper namespace="com.springboot.dwxcp.mapper.PartyBranchEvaluationMapper">
    <resultMap id="BaseResultMap" type="com.springboot.dwxcp.entity.PartyBranchEvaluation">
        <id column="id" property="id"/>
        <result column="year" property="year"/>
        <result column="party_branch" property="partyBranch"/>
        <result column="quarter" property="quarter"/>
        <result column="level" property="level"/>
    </resultMap>

    <!--
        支部评议列表：分页由 PageHelper.startPage 控制
        三个字段全部是枚举值，= 走索引
    -->
    <select id="getPartyBranchEvaluationList" resultMap="BaseResultMap">
        SELECT id, year, party_branch, quarter, level
        FROM party_branch_evaluation
        <where>
            <if test="partyBranch != null and partyBranch != ''">
                AND party_branch = #{partyBranch}
            </if>
            <if test="year != null and year != ''">
                AND year = #{year}
            </if>
            <if test="quarter != null and quarter != ''">
                AND quarter = #{quarter}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <insert id="addPartyBranchEvaluation" useGeneratedKeys="true" keyProperty="id">
        insert into party_branch_evaluation (year, party_branch, quarter, level)
        values (#{year}, #{partyBranch}, #{quarter}, #{level})
    </insert>

    <delete id="deletePartyBranchEvaluationById">
        delete from party_branch_evaluation where id = #{id}
    </delete>

    <update id="editPartyBranchEvaluationById" parameterType="com.springboot.dwxcp.entity.PartyBranchEvaluation">
        update party_branch_evaluation
        <set>
            <if test="year != null and year != ''">
                year = #{year},
            </if>
            <if test="partyBranch != null and partyBranch != ''">
                party_branch = #{partyBranch},
            </if>
            <if test="quarter != null and quarter != ''">
                quarter = #{quarter},
            </if>
            <if test="level != null and level != ''">
                level = #{level}
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>