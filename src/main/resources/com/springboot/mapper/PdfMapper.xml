<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.dwxcp.mapper.PdfMapper">

    <select id="selectPdfListWithoutContent" resultType="com.springboot.dwxcp.entity.Pdf">
        select id, file_name, file_type, file_content from pdf
        <if test="type != null and type != ''">
            where file_type = #{type}
        </if>
        order by id desc
    </select>

    <select id="selectPdfById" resultType="com.springboot.dwxcp.entity.Pdf">
        select id, file_name, file_type, file_content from pdf where id = #{id}
    </select>

    <delete id="deletePdfById">
        delete from pdf where id = #{id}
    </delete>

</mapper>
