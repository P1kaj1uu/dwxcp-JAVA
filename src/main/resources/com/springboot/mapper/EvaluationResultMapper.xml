<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.dwxcp.mapper.EvaluationResultMapper">
    <select id="getEvaluationResultList" resultType="com.springboot.dwxcp.entity.EvaluationResult">
        select * from evaluation_result
    </select>

    <insert id="addEvaluationResult" useGeneratedKeys="true" keyProperty="id">
        insert into evaluation_result (one, two, three, four, years)
        values (#{one}, #{two}, #{three}, #{four}, #{years})
    </insert>

    <update id="editEvaluationResultById" parameterType="com.springboot.dwxcp.entity.EvaluationResult">
        update evaluation_result
        <set>
            <if test="one != null and one != ''">
                one = #{one},
            </if>
            <if test="two != null and two != ''">
                two = #{two},
            </if>
            <if test="three != null and three != ''">
                three = #{three},
            </if>
            <if test="four != null and four != ''">
                four = #{four},
            </if>
            <if test="years != null and years != ''">
                years = #{years}
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>