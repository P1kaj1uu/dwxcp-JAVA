<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.dwxcp.mapper.EvaluationResultMapper">
    <resultMap id="BaseResultMap" type="com.springboot.dwxcp.entity.EvaluationResult">
        <id column="id" property="id"/>
        <result column="one" property="one"/>
        <result column="two" property="two"/>
        <result column="three" property="three"/>
        <result column="four" property="four"/>
        <result column="years" property="years"/>
    </resultMap>

    <select id="getEvaluationResultList" resultMap="BaseResultMap">
        SELECT id, one, two, three, four, years
        FROM evaluation_result
        ORDER BY id DESC
    </select>

    <insert id="addEvaluationResult" useGeneratedKeys="true" keyProperty="id">
        insert into evaluation_result (one, two, three, four, years)
        values (#{one}, #{two}, #{three}, #{four}, #{years})
    </insert>

    <update id="editEvaluationResultById" parameterType="com.springboot.dwxcp.entity.EvaluationResult">
        update evaluation_result
        <set>
            <if test="one != null and one != ''">
                one = #{one},
            </if>
            <if test="two != null and two != ''">
                two = #{two},
            </if>
            <if test="three != null and three != ''">
                three = #{three},
            </if>
            <if test="four != null and four != ''">
                four = #{four},
            </if>
            <if test="years != null and years != ''">
                years = #{years}
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>