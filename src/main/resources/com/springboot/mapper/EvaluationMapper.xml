<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    namespace：命名空间
    id：sql语句的唯一标识
    resultType：返回值类型
-->
<mapper namespace="com.springboot.dwxcp.mapper.EvaluationMapper">
    <resultMap id="BaseResultMap" type="com.springboot.dwxcp.entity.Evaluation">
        <id column="id" property="id"/>
        <result column="year" property="year"/>
        <result column="quarter" property="quarter"/>
        <result column="party_branch" property="partyBranch"/>
        <result column="name" property="name"/>
        <result column="responsibility_post" property="responsibilityPost"/>
        <result column="responsibility_area" property="responsibilityArea"/>
        <result column="comments" property="comments"/>
        <result column="good" property="good"/>
        <result column="safetyStar" property="safetyStar"/>
    </resultMap>

    <!--
        评议列表：分页由 PageHelper.startPage 控制
        - year / quarter / partyBranch / responsibilityPost 是下拉枚举，全部走 =
        - name / responsibilityArea 是文本搜索，改为前缀匹配（走索引）
    -->
    <select id="getEvaluationList" resultMap="BaseResultMap">
        SELECT id, year, quarter, party_branch, name, responsibility_post,
               responsibility_area, comments, good, safetyStar
        FROM evaluation
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT(#{name}, '%')
            </if>
            <if test="year != null and year != ''">
                AND year = #{year}
            </if>
            <if test="quarter != null and quarter != ''">
                AND quarter = #{quarter}
            </if>
            <if test="responsibilityPost != null and responsibilityPost != ''">
                AND responsibility_post = #{responsibilityPost}
            </if>
            <if test="responsibilityArea != null and responsibilityArea != ''">
                AND responsibility_area LIKE CONCAT(#{responsibilityArea}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <insert id="addEvaluation" useGeneratedKeys="true" keyProperty="id">
        insert into evaluation (year, quarter, party_branch, name, responsibility_post, responsibility_area, comments, good, safetyStar)
        values (#{year}, #{quarter}, #{partyBranch}, #{name}, #{responsibilityPost}, #{responsibilityArea}, #{comments}, #{good}, #{safetyStar})
    </insert>

    <delete id="deleteEvaluationById">
        delete from evaluation where id = #{id}
    </delete>

    <update id="editEvaluationById" parameterType="com.springboot.dwxcp.entity.Evaluation">
        update evaluation
        <set>
            <if test="year != null and year != ''">
                year = #{year},
            </if>
            <if test="quarter != null and quarter != ''">
                quarter = #{quarter},
            </if>
            <if test="partyBranch != null and partyBranch != ''">
                party_branch = #{partyBranch},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="responsibilityPost != null and responsibilityPost != ''">
                responsibility_post = #{responsibilityPost},
            </if>
            <if test="responsibilityArea != null and responsibilityArea != ''">
                responsibility_area = #{responsibilityArea},
            </if>
            <if test="comments != null and comments != ''">
                comments = #{comments},
            </if>
            <if test="good != null and good != ''">
                good = #{good},
            </if>
            <if test="safetyStar != null and safetyStar != ''">
                safetyStar = #{safetyStar}
            </if>
        </set>
        where id = #{id}
    </update>

    <insert id="batchAddEvaluation" parameterType="list">
        insert into evaluation (year, quarter, party_branch, name, responsibility_post, responsibility_area, comments, good, safetyStar)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.year}, #{item.quarter}, #{item.partyBranch}, #{item.name},
            #{item.responsibilityPost}, #{item.responsibilityArea}, #{item.comments}, #{item.good}, #{item.safetyStar})
        </foreach>
    </insert>
</mapper>